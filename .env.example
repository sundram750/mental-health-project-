# Environment Variables - Example File
# Is file ko copy karke .env banao aur apni values bharo
# .env kabhi GitHub pe push mat karo!

# Flask Settings
FLASK_ENV=production
FLASK_DEBUG=False

# Server Settings (cloud platform automatically set karta hai PORT)
PORT=5000
HOST=0.0.0.0

# Optional: Secret key for sessions (random string generate karo)
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here
